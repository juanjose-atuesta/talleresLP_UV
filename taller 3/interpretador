;;INTERPRETADOR
;;ESPECIFICACION LEXICA Y SINTACTICA (SLLGEN)
(define scanner-spec
  '((white-sp (whitespace) skip)
    (comment ("%" (arbno (not #\newline))) skip)
    (numero (digit (arbno digit)) number)
    (numero ("-" digit (arbno digit)) number)
    (numero (digit (arbno digit) "." digit (arbno digit)) number)
    (numero ("-" digit (arbno digit) "." digit (arbno digit)) number)
    (texto ((or letter "_" ":") (arbno (or letter digit "_" ":" "-"))) symbol)
    (identificador ("@" letter (arbno (or letter digit "_" "?"))) symbol)))

(define grammar
  '((programa (expresion) un-programa)
    (expresion (numero) numero-lit)
    (expresion ("\"" texto "\"") texto-lit)
    (expresion (identificador) var-exp)
    (expresion ("(" expresion primitiva-binaria expresion ")") primapp-bin-exp)
    (expresion (primitiva-unaria "(" expresion ")") primapp-un-exp)
    (expresion ("Si" expresion "{" expresion "}" "sino" "{" expresion "}") condicional-exp)
    (expresion ("declarar" "(" (arbno identificador "=" expresion ";") ")" "{" expresion "}") variableLocal-exp)
    (expresion ("procedimiento" "(" (separated-list identificador ",") ")" "{" expresion "}") procedimiento-ex)
    (expresion ("evaluar" expresion "(" (separated-list expresion ",") ")" "finEval") app-exp)
    (expresion ("declarar-rec" "(" (arbno identificador "(" (separated-list identificador ",") ")" "=" expresion ";") ")" "{" expresion "}") declarar-rec-exp)
    (primitiva-binaria ("+") primitiva-suma)
    (primitiva-binaria ("~") primitiva-resta)
    (primitiva-binaria ("/") primitiva-div)
    (primitiva-binaria ("*") primitiva-multi)
    (primitiva-binaria ("concat") primitiva-concat)
    (primitiva-binaria (">") primitiva-mayor)
    (primitiva-binaria ("<") primitiva-menor)
    (primitiva-binaria (">=") primitiva-mayor-igual)
    (primitiva-binaria ("<=") primitiva-menor-igual)
    (primitiva-binaria ("!=") primitiva-diferente)
    (primitiva-binaria ("==") primitiva-comparador-igual)
    (primitiva-unaria ("longitud") primitiva-longitud)
    (primitiva-unaria ("add1") primitiva-add1)
    (primitiva-unaria ("sub1") primitiva-sub1)
    (primitiva-unaria ("neg") primitiva-negacion-booleana)))

(sllgen:make-define-datatypes scanner-spec grammar)
(define scan&parse (sllgen:make-string-parser scanner-spec grammar))

;;DATATYPES PARA PROCEDIMIENTOS Y AMBIENTES
(define-datatype procVal procVal?
  (cerradura (lista-ID (list-of symbol?)) (exp expresion?) (amb ambiente?)))

(define-datatype ambiente ambiente?
  (empty-env-record)
  (extended-env-record (syms (list-of symbol?)) (vals (list-of scheme-value?)) (env ambiente?))
  (recursively-extended-env-record (proc-names (list-of symbol?)) (idss (list-of (list-of symbol?))) (bodies (list-of expresion?)) (env ambiente?)))

(define scheme-value? (lambda (v) #t))

;;AMBIENTE INICIAL Y BUSQUEDA DE VARIABLES
(define ambiente-inicial
  (extended-env-record '(@a @b @c @d @e) '(1 2 3 "hola" "FLP") (empty-env-record)))

(define buscar-variable
  (lambda (sym env)
    (cases ambiente env
      (empty-env-record () (eopl:error 'buscar-variable "Error, la variable ~s no existe" sym))
      (extended-env-record (syms vals env-saved)
        (let ((pos (rib-find-position sym syms)))
          (if (number? pos) (list-ref vals pos) (buscar-variable sym env-saved))))
      (recursively-extended-env-record (proc-names idss bodies env-saved)
        (let ((pos (rib-find-position sym proc-names)))
          (if (number? pos) (cerradura (list-ref idss pos) (list-ref bodies pos) env) (buscar-variable sym env-saved)))))))

(define rib-find-position
  (lambda (sym syms)
    (let loop ((syms syms) (pos 0))
      (cond ((null? syms) #f) ((eqv? sym (car syms)) pos) (else (loop (cdr syms) (+ pos 1)))))))

;;EVALUADOR PRINCIPAL
(define eval-program (lambda (pgm) (cases programa pgm (un-programa (exp) (eval-expression exp ambiente-inicial)))))
(define valor-verdad? (lambda (val) (not (and (number? val) (zero? val)))))

(define eval-expression
  (lambda (exp amb)
    (cases expresion exp
      (numero-lit (num) num)
      (texto-lit (txt) (if (symbol? txt) (symbol->string txt) txt))
      (var-exp (id) (buscar-variable id amb))
      (primapp-bin-exp (exp1 prim exp2) (eval-prim-bin (eval-expression exp1 amb) prim (eval-expression exp2 amb)))
      (primapp-un-exp (prim exp1) (eval-prim-un prim (eval-expression exp1 amb)))
      (condicional-exp (test-exp true-exp false-exp)
        (if (valor-verdad? (eval-expression test-exp amb)) (eval-expression true-exp amb) (eval-expression false-exp amb)))
      (variableLocal-exp (ids exps cuerpo)
        (let ((vals (eval-rands exps amb))) (eval-expression cuerpo (extended-env-record ids vals amb))))
      (procedimiento-ex (ids cuerpo) (cerradura ids cuerpo amb))
      (app-exp (rator rands)
        (let ((proc (eval-expression rator amb)) (args (eval-rands rands amb)))
          (if (procVal? proc) (apply-procedure proc args) (eopl:error 'eval-expression "No es procedimiento ~s" proc))))
      (declarar-rec-exp (proc-names idss bodies cuerpo)
        (eval-expression cuerpo (recursively-extended-env-record proc-names idss bodies amb))))))

(define eval-rands (lambda (exps amb) (map (lambda (e) (eval-expression e amb)) exps)))

(define apply-procedure
  (lambda (proc args)
    (cases procVal proc
      (cerradura (ids cuerpo amb-guardado)
        (if (= (length ids) (length args))
            (eval-expression cuerpo (extended-env-record ids args amb-guardado))
            (eopl:error 'apply-procedure "Argumentos incorrectos"))))))

(define eval-prim-bin
  (lambda (v1 prim v2)
    (cases primitiva-binaria prim
      (primitiva-suma () (+ v1 v2))
      (primitiva-resta () (- v1 v2))
      (primitiva-div () (/ v1 v2))
      (primitiva-multi () (* v1 v2))
      (primitiva-concat () (string-append (to-string v1) (to-string v2)))
      (primitiva-mayor () (if (> v1 v2) 1 0))
      (primitiva-menor () (if (< v1 v2) 1 0))
      (primitiva-mayor-igual () (if (>= v1 v2) 1 0))
      (primitiva-menor-igual () (if (<= v1 v2) 1 0))
      (primitiva-diferente () (if (not (equal? v1 v2)) 1 0))
      (primitiva-comparador-igual () (if (equal? v1 v2) 1 0)))))

(define eval-prim-un
  (lambda (prim v1)
    (cases primitiva-unaria prim
      (primitiva-longitud () (string-length (to-string v1)))
      (primitiva-add1 () (+ v1 1))
      (primitiva-sub1 () (- v1 1))
      (primitiva-negacion-booleana () (if (valor-verdad? v1) 0 1)))))

(define to-string
  (lambda (val)
    (cond ((string? val) val) ((symbol? val) (symbol->string val)) ((number? val) (number->string val)) (else ""))))

;;REPL
(define interpretador (sllgen:make-rep-loop "--> " (lambda (pgm) (eval-program pgm)) (sllgen:make-stream-parser scanner-spec grammar)))


